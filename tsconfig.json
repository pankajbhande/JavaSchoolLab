{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    /* Vite/esbuild owns emit — tsc is used purely as a checker. */
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /*
     * This codebase went ~112k lines with no type checking at all, so turning on the
     * full strict suite at once would bury real defects under thousands of pre-existing
     * findings. `strict` is off for now and the two checks below are the ones that
     * actually catch bugs rather than style. Tighten these one flag at a time:
     *   strictNullChecks -> noImplicitAny -> strict
     *
     * noImplicitReturns was tried and removed: its only hits were the standard React
     * early-return-from-effect idiom, which is correct code.
     */
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "server"]
}
