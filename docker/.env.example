# Copy to .env (git-ignored) in this docker/ folder, next to docker-compose.yml and fill in the blanks.

# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# REQUIRED. Use strong, different passwords.
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_USER=jsl
DB_NAME=javaschoollab

# Public origin(s) of the site, comma-separated. Must match what users type in the browser.
CORS_ORIGIN=http://localhost:8080

# Host port for the website.
WEB_PORT=8080

# Baked in at image BUILD time (rebuild after changing). Leave /api: the Spring Boot app serves the site and the API from the same address.
VITE_API_BASE_URL=/api
SITE_URL=https://javaschoollab.com
VITE_ADSENSE_CLIENT=

# ---- Email (OTP codes) -------------------------------------------------------
# Hostinger SMTP. Port 465 = SSL (use 587 only with SMTP_SECURE=false).
# Quote the password with single quotes so characters like # and $ are kept literally.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@dhipansoft.in
SMTP_PASS=
SMTP_FROM=JavaSchoolLab <info@dhipansoft.in>

# ---- Admin (analytics dashboard at /admin) ------------------------------------
# Comma-separated emails that may open /admin after signing in. Leave empty to keep it closed.
ADMIN_EMAILS=

# ---- Database backups (the "backup" service) ----------------------------------
# A gzipped mysqldump is written to ../backups every BACKUP_EVERY_HOURS hours; older than BACKUP_KEEP_DAYS days are deleted.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=14
