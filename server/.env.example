# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored and must never be committed.

# Signing key for JWTs. REQUIRED — the server refuses to start without it.
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this value invalidates every issued token (all users get logged out).
JWT_SECRET=

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=javaschoollab
DB_POOL_SIZE=10

# API listen port
PORT=3001

# Comma-separated list of front-end origins allowed to call this API.
# Leave blank in local dev to allow any origin. ALWAYS set this in production.
# e.g. CORS_ORIGIN=https://javaschoollab.com,https://www.javaschoollab.com
CORS_ORIGIN=

# Number of reverse proxies in front of this API (nginx, load balancer). Needed so the per-client
# rate limit on public certificate verification sees real visitor addresses. Leave blank if none.
TRUST_PROXY=

# Set to "true" ONLY for local development without an SMS/email provider:
# returns the OTP in the API response so you can log in. Ignored when
# NODE_ENV=production, so it can never leak in a real deployment.
OTP_DEV_ECHO=true

# Set to "production" when deploying.
NODE_ENV=development

# Email OTP delivery. Leave SMTP_HOST empty in local dev to see the OTP in the server console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
