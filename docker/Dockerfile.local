# Fast path: packages the ALREADY-BUILT site (dist/) with nginx. No npm install inside Docker.
# Build the site first, from the frontend folder:
#   (PowerShell)  $env:VITE_API_BASE_URL="/api"; npx vite build
FROM nginx:1.27-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO /dev/null http://127.0.0.1/healthz || exit 1
