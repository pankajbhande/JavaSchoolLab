        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_requests_seconds_count{application=\"javaschoollab\",status=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_requests_seconds_count{application=\"javaschoollab\"}[$__range])))",
          "legendFormat": "",
