{
  "uid": "jsl-logs-traces",
  "title": "JavaSchoolLab - Logs and traces",
  "description": "Search the application logs, find slow or failing requests as traces, and jump from a log line to its trace (and back). In production the application writes one JSON object per log line, with the traceId of the request.",
  "tags": [
    "javaschoollab",
    "logs",
    "traces",
    "loki",
    "tempo"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "TRACE,DEBUG,INFO,WARN,ERROR",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": false,
            "text": "TRACE",
            "value": "TRACE"
          },
          {
            "selected": false,
            "text": "DEBUG",
            "value": "DEBUG"
          },
          {
            "selected": false,
            "text": "INFO",
            "value": "INFO"
          },
          {
            "selected": false,
            "text": "WARN",
            "value": "WARN"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "ERROR"
          }
        ],
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search text",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "JavaSchoolLab dashboards",
      "type": "dashboards",
      "tags": [
        "javaschoollab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Application logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Application log lines by level",
      "description": "Click a bar to zoom. ERROR bars need attention.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({container=\"javaschoollab-app\"} [$__interval]))",
          "legendFormat": "{{level}}",
          "refId": "A",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Errors in the selected range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"javaschoollab-app\", level=\"ERROR\"} [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Warnings in the selected range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"javaschoollab-app\", level=\"WARN\"} [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              },
              {
                "color": "orange",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "logs",
      "title": "Application logs (use the Log level and Search text filters above)",
      "description": "Expand a line, then use \"View trace\" on the traceId to open the whole request in Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"javaschoollab-app\", level=~\"$level\"} | json | message=~\"(?i).*$search.*\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": false
      },
      "id": 5,
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "All containers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines per container",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({compose_project=~\"javaschoollab.*\"} [$__interval]))",
          "legendFormat": "{{container}}",
          "refId": "A",
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "logs",
      "title": "Warnings and errors from every container",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{compose_project=~\"javaschoollab.*\"} |~ \"(?i)(error|exception|fatal|warn)\" | container != \"javaschoollab-alloy\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "enableInfiniteScrolling": false
      },
      "id": 8,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Traces (Tempo)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Latest traces of the application",
      "description": "Click a trace id to see every step of that request.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"javaschoollab\" }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "table",
      "title": "Slow requests (longer than 500 ms)",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"javaschoollab\" && duration > 500ms }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 31
      }
    },
    {
      "type": "table",
      "title": "Failed requests",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"javaschoollab\" && status = error }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "table",
      "title": "Slow SQL (longer than 200 ms)",
      "description": "Spans created for every SQL statement by the JDBC observation.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"javaschoollab\" && name =~ \"query.*\" && duration > 200ms }",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service map",
      "description": "Built from the span metrics Tempo writes to Prometheus: the application and the databases it calls.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap",
          "refId": "A"
        }
      ],
      "options": {},
      "id": 14,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 49
      }
    }
  ]
}
