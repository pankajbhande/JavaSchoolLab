target/
.idea/
*.iml
/application.properties

# Eclipse / STS files written when the project is imported
.project
.classpath
.settings/
bin/
.factorypath

# Written by docker/scripts/auto-deploy.sh on the server (deployed commit, last good image, lock)
.deploy/
