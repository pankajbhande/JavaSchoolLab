# Copy to .env.local for local overrides, or set these in your host's build config.
# Vite only exposes variables prefixed with VITE_ to the browser —
# never put a secret in this file, it ends up in the shipped bundle.
#
# These are inlined at BUILD time, not read at runtime: a Docker image has to be rebuilt
# (or given these as build args) for a change here to take effect.

# Base URL of the JavaSchoolLab API.
# Defaults to http://localhost:3001/api when unset, so local dev needs no .env at all.
# Set to /api for a deployment where Nginx proxies the API on the same origin.
VITE_API_BASE_URL=http://localhost:3001/api

# ---- AdSense -----------------------------------------------------------------
# Publisher id from AdSense > Account > Settings, e.g. ca-pub-1234567890123456.
# Leave BLANK until the site is approved: blank disables every ad slot cleanly,
# with no empty boxes and no ad script downloaded.
VITE_ADSENSE_CLIENT=

# Ad unit ids from AdSense > Ads > By ad unit > Display ads.
# Create three units named jsl-rail-top, jsl-rail-bottom and jsl-corner.
VITE_AD_SLOT_RAIL_TOP=
VITE_AD_SLOT_RAIL_BOTTOM=
VITE_AD_SLOT_CORNER=
