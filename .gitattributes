# Normalise line endings so the repo does not churn between Windows and CI/Linux.
* text=auto eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.woff binary
*.woff2 binary

# Generated - collapse in diffs and exclude from language stats.
package-lock.json      linguist-generated=true
public/sitemap.xml     linguist-generated=true
src/app/data/courseStats.ts linguist-generated=true

# The course content dwarfs the application code; keep language stats honest.
src/app/data/** linguist-documentation=true

# Shell scripts run inside Linux containers: always LF
*.sh text eol=lf
